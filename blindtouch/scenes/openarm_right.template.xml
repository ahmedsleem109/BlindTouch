<!--
Single OpenArm v2 right arm, torque controlled, holding a peg.

Derived from Enactic's openarm_mujoco v2 bimanual model (Apache-2.0, see
assets/LICENSE-openarm). Changes from the original:
  * only the right arm is kept;
  * the position servos are replaced by `motor` actuators, so the control input
    is joint torque -- the same signal a real driver reports as motor current;
  * joint `frictionloss` is zero here: friction is a realism effect that
    blindtouch/sim/realism.py switches on per episode, so the nominal model (the
    one the robot believes) and the true plant can differ in a controlled way;
  * two variants of the hand (build.py): the true plant has the real
    gripper -- hinged fingers coupled by a mimic constraint, squeezed by a
    position servo, fingertip collision with torsional friction -- holding a
    free peg by friction alone; the nominal model the robot believes has the
    fingers frozen at the grasp angle and the peg rigidly attached (a known
    payload), so a peg that slips or tilts in the grasp is a real, unmodelled
    error.

Collision filtering: arm geoms use contype=2 conaffinity=1 and the world uses
contype=1 conaffinity=2, so the arm never collides with itself but does with
the table, the hole, the wiping board and the poke probes.

Included by the scene files with <include file="openarm_right.xml"/>.
-->
<mujoco model="openarm_right">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <default>
    <default class="arm">
      <joint type="hinge" limited="true" frictionloss="0" />
      <default class="dm8009">
        <joint damping="1.0" armature="0.0081" />
        <motor ctrlrange="-40 40" />
      </default>
      <default class="dm4340">
        <joint damping="0.9" armature="0.16" />
        <motor ctrlrange="-27 27" />
      </default>
      <default class="dm4310">
        <joint damping="0.9" armature="0.01" />
        <motor ctrlrange="-7 7" />
      </default>
      <default class="arm_collision">
        <geom group="3" contype="2" conaffinity="1" condim="3" solref="0.004 1" friction="0.8 0.01 0.001" rgba="0.8 0.2 0.2 0.5" />
      </default>
      <default class="finger">
        <joint damping="2" armature="0.01" frictionloss="0" />
      </default>
      <default class="fingertip">
        <!-- condim 4: torsional friction. 0.02 m effective patch radius: a rubber pad conforming around the 24 mm
             peg gives a ~20 mm tall contact strip; with 0.01 the peg crept ~1 deg per probe in the grasp -->
        <geom group="3" contype="2" conaffinity="1" condim="4" solref="0.004 1" friction="1 0.02 0.01" rgba="0.8 0.2 0.2 0.5" />
      </default>
      <default class="arm_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" />
      </default>
    </default>
  </default>

  <asset>
    <material name="pale_silver" rgba="0.75 0.75 0.75 1" specular="1.0" shininess="0.9" reflectance="0.2" />
    <material name="metal_silver" rgba="0.65 0.65 0.65 1.0" specular="1.0" shininess="0.9" reflectance="0.2" />
    <material name="matte_black" rgba="0.16 0.16 0.17 1.0" reflectance="0.05" shininess="0.5" />
    <material name="peg_mat" rgba="0.85 0.55 0.15 1" specular="0.6" shininess="0.6" />

    <mesh name="base_link_00" file="arm/base_link_00.obj" />
    <mesh name="base_link_01" file="arm/base_link_01.obj" />
    <mesh name="base_link_c" file="collision/base_link.stl" />
    <mesh name="link1_00" file="arm/link1_00.obj" />
    <mesh name="link1_01" file="arm/link1_01.obj" />
    <mesh name="link1_02" file="arm/link1_02.obj" />
