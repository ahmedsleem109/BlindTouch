    <mesh name="finger_inner_c1" file="collision/finger_inner_part_01.stl" />
    <mesh name="finger_inner_c2" file="collision/finger_inner_part_02.stl" />
    <mesh name="finger_inner_c3" file="collision/finger_inner_part_03.stl" />
    <mesh name="finger_outer_c0" file="collision/finger_outer_part_00.stl" />
    <mesh name="finger_outer_c1" file="collision/finger_outer_part_01.stl" />
    <mesh name="finger_outer_c2" file="collision/finger_outer_part_02.stl" />
    <mesh name="finger_outer_c3" file="collision/finger_outer_part_03.stl" />
  </asset>

